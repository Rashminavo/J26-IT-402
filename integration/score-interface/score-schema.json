{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j26-it-402.github.io/schemas/component-score.schema.json",
  "title": "J26-IT-402 Component Score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "user_id",
    "component",
    "timestamp",
    "data_status",
    "score",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": ["string", "null"]
    },
    "component": {
      "type": "string",
      "enum": [
        "language_analysis",
        "behavioural_tracking",
        "facial_analysis",
        "physiological_analysis"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data_status": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "PARTIAL",
        "UNAVAILABLE"
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "min",
        "max",
        "normalized_value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": ["number", "null"]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "normalized_value": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "risk_level": {
      "type": ["string", "null"]
    },
    "risk_level_scheme": {
      "type": ["string", "null"]
    },
    "data_quality": {
      "type": ["object", "null"]
    },
    "model": {
      "type": ["object", "null"]
    },
    "metadata": {
      "type": "object"
    }
  }
}